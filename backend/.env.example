# Copy this file to ".env" and fill in your own values. Never commit ".env".

# MongoDB connection string (local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/bugsbon_hrms

# Secret used to sign login tokens. Use a long random string (32+ characters).
# Generate one in PowerShell:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login stays valid
JWT_EXPIRES_IN=8h

# API server port
PORT=5000

# Frontend address allowed to call the API (Vite dev server default)
CLIENT_ORIGIN=http://localhost:5173

# Only used by "npm run seed:admin" to create the first Super Admin.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
